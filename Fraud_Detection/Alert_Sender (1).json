    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nlet lastAlertRow = 0;\n\n// 1️⃣ Find the last row where Alert Sent = TRUE\nfor (const item of rows) {\n  const alertValue = String(item.json[\"Alert Sent\"]).trim().toLowerCase();\n\n  if (alertValue === \"true\") {\n    lastAlertRow = item.json.row_number;\n  }\n}\n\n// 2️⃣ Count identical fraud entries\nconst fraudCounts = {};\nconst lastRows = {};\n\nfor (const item of rows) {\n\n  const row = item.json;\n\n  // Skip rows before the last alert\n  if (row.row_number <= lastAlertRow) continue;\n\n  // Skip safe rows\n  if (String(row[\"Risk\"]).trim().toLowerCase() === \"safe\") continue;\n\n  const fraudType = row[\"Fraud Type\"];\n  const risk = row[\"Risk\"];\n\n  if (!fraudType) continue;\n\n  // Normalize fraud type format\n  const normalizedFraud = fraudType\n    .replace(/\\//g, \",\")\n    .split(\",\")\n    .map(t => t.trim())\n    .sort()\n    .join(\" + \");\n\n  // Create unique key (same fraud + same risk)\n  const key = `${normalizedFraud} | ${risk}`;\n\n  if (!fraudCounts[key]) {\n    fraudCounts[key] = 0;\n  }\n\n  fraudCounts[key]++;\n\n  // Track the latest row for this fraud\n  lastRows[key] = row.row_number;\n}\n\n// 3️⃣ Check if any fraud reached threshold\nlet triggerAlert = false;\nlet alertFraudType = null;\nlet alertCount = 0;\nlet alertRow = null;\n\nfor (const key in fraudCounts) {\n\n  if (fraudCounts[key] >= 5) {\n\n    triggerAlert = true;\n    alertFraudType = key;\n    alertCount = fraudCounts[key];\n    alertRow = lastRows[key];\n\n    break;\n  }\n\n}\n\n// 4️⃣ Return results for workflow branching\nreturn [{\n  trigger_alert: triggerAlert,\n  fraud_type: alertFraudType,\n  fraud_count: alertCount,\n  last_row_to_update: alertRow\n}];"
      },
