    {
      "parameters": {
        "jsCode": "const text = $json.text;\n\nlet intent = \"UNKNOWN\";\nlet fraudType = \"N/A\";\nlet riskLevel = \"N/A\";\nlet fraudProbability = \"N/A\";\n\n// Detect intent\nif (text.includes(\"INTENT: FRAUD_CHECK\")) {\n  intent = \"FRAUD_CHECK\";\n}\n\nif (text.includes(\"INTENT: AWARENESS_QUERY\")) {\n  intent = \"AWARENESS_QUERY\";\n}\n\nif (text.includes(\"INTENT: CASUAL_CHAT\")) {\n  intent = \"CASUAL_CHAT\";\n}\n\n// Clean markdown formatting\nconst cleanText = text.replace(/\\*\\*/g, \"\");\n\n// Extract Risk Level\nconst riskMatch = cleanText.match(/Risk Level:\\s*([A-Za-z]+)/i);\nif (riskMatch) {\n  riskLevel = riskMatch[1].trim();\n}\n\n// Extract Fraud Type\nconst typeMatch = cleanText.match(/Fraud Type:\\s*(.*)/i);\nif (typeMatch) {\n  fraudType = typeMatch[1].trim();\n}\n\n// Extract Fraud Probability\nconst probMatch = cleanText.match(/Fraud Probability:\\s*(\\d+)%?/i);\nif (probMatch) {\n  fraudProbability = probMatch[1];\n}\n\nreturn [{\n  intent: intent,\n  fraud_type: fraudType,\n  risk_level: riskLevel,\n  fraud_probability: fraudProbability,\n  reply: cleanText.replace(/INTENT:.*/,'').trim()\n}];"
      },
